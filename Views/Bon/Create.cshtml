@model CreateBonViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Bon baru";
    ViewData["BackHref"] = Url.Action("Index", "Bon");

    // Amounts read like the rest of the notebook: Rp 185.000, with at most two decimals.
    string FormatRupiah(decimal jumlah) =>
        $"Rp {jumlah.ToString("#,##0.##", CultureInfo.GetCultureInfo("id-ID"))}";

    // The picker carries the raw price in data-harga, so the line arithmetic never parses a label.
    string FormatHarga(decimal harga) =>
        harga.ToString("0.##", CultureInfo.InvariantCulture);

    var selectedCustomer = Model.Customers.FirstOrDefault(customer => customer.Id == Model.PelangganId);
    var pelangganLabel = selectedCustomer?.Nama ?? "Pilih pelanggan";
}

<hr class="page-rule" />

<form method="post" asp-action="Create" class="pelanggan-form">
    @* Item lines are added by script, so every message is reported at the top of the form. *@
    <div asp-validation-summary="All" class="pelanggan-field-error" role="alert"></div>

    <div class="pelanggan-field">
        <span class="pelanggan-field-label" id="pelangganLabel">Pelanggan</span>
        <div class="bon-field-with-icon">
            <input asp-for="PelangganId" type="hidden" id="pelanggan" />
            <button type="button"
                    id="pilihPelangganBtn"
                    class="bon-picker-trigger bon-customer-trigger@(selectedCustomer is null ? " is-empty" : "")"
                    aria-haspopup="dialog"
                    aria-expanded="false"
                    aria-controls="bonCustomerPicker"
                    aria-labelledby="pelangganLabel pelangganValue">
                <span id="pelangganValue" class="bon-customer-trigger-label">@pelangganLabel</span>
            </button>
            <i class="bi bi-caret-down bon-field-icon" aria-hidden="true"></i>
        </div>
        <span asp-validation-for="PelangganId" class="pelanggan-field-error"></span>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-field">
        <label class="pelanggan-field-label" for="tanggal">Tanggal</label>
        <div class="bon-field-with-icon">
            <input asp-for="Tanggal"
                   type="date"
                   id="tanggal"
                   class="pelanggan-field-input bon-date" />
            <i class="bi bi-calendar bon-field-icon" aria-hidden="true"></i>
        </div>
        <span asp-validation-for="Tanggal" class="pelanggan-field-error"></span>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-field">
        <label class="pelanggan-field-label" for="totalBayar">Total Bayar</label>
        <input asp-for="TotalBayar"
               type="text"
               id="totalBayar"
               inputmode="decimal"
               class="pelanggan-field-input bon-money-input"
               placeholder="Tulis total bayar"
               autocomplete="off" />
        <span asp-validation-for="TotalBayar" class="pelanggan-field-error"></span>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-field">
        <label class="pelanggan-field-label" for="catatan">Catatan</label>
        <textarea asp-for="Catatan"
                  id="catatan"
                  class="pelanggan-field-input pelanggan-field-textarea"
                  placeholder="Tulis catatan"
                  rows="2"></textarea>
        <span asp-validation-for="Catatan" class="pelanggan-field-error"></span>
        <hr class="page-rule" />
    </div>

    <div class="bon-daftar-head">
        <div class="bon-daftar-title">Daftar barang</div>
        <button type="button" id="tambahBarangBtn" class="bon-tambah" style="pointer-events: auto">
            <i class="bi bi-plus"></i>
            <span>Tambah barang</span>
        </button>
    </div>

    <div id="bonLinesContainer">
        <!-- baris barang akan ditambahkan oleh JavaScript -->
    </div>

    <div class="bon-total-row">
        <div class="bon-total-label">Total belanja</div>
        <div class="bon-total-value" id="totalBelanja">Rp 0</div>
    </div>

    <div class="pelanggan-form-actions">
        <a class="pelanggan-btn pelanggan-btn-batal"
           asp-controller="Bon"
           asp-action="Index">Batal</a>
        <button type="submit" class="pelanggan-btn pelanggan-btn-simpan">Simpan catatan</button>
    </div>
</form>

<template id="bonLineTemplate">
    <div class="bon-line" data-line-index="">
        <div class="bon-field-with-icon">
            <input type="hidden" class="barang-hidden" />
            <button type="button"
                    class="bon-picker-trigger is-empty barang-trigger"
                    aria-haspopup="dialog"
                    aria-expanded="false"
                    aria-controls="bonPicker">
                <span class="barang-trigger-label">Pilih barang</span>
            </button>
            <i class="bi bi-chevron-down bon-field-icon" aria-hidden="true"></i>
        </div>
        <hr class="page-rule" />

        <div class="bon-line-metrics">
            <div class="bon-line-col">
                <div class="pelanggan-field-label">Harga</div>
                <div class="bon-line-money barang-harga" data-harga="0">Rp 0</div>
            </div>
            <div class="bon-line-col bon-line-col--qty">
                <label class="pelanggan-field-label">Jumlah</label>
                <input type="number"
                       min="1"
                       value="1"
                       class="bon-line-qty barang-jumlah" />
            </div>
            <div class="bon-line-col">
                <div class="pelanggan-field-label">Satuan</div>
                <div class="bon-line-satuan barang-satuan">-</div>
            </div>
        </div>

        <div class="bon-line-subtotal">
            <div class="bon-line-col">
                <div class="pelanggan-field-label">Subtotal</div>
                <div class="bon-line-money barang-subtotal">Rp 0</div>
            </div>
            <button type="button" class="bon-hapus hapus-barang" aria-label="Hapus barang" style="pointer-events: auto">
                <i class="bi bi-trash" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</template>


<div id="bonPicker" class="bon-picker" hidden>
    <div class="bon-picker-scrim" data-bon-picker-close></div>
    <div class="bon-picker-sheet"
         role="dialog"
         aria-modal="true"
         aria-labelledby="bonPickerTitle">
        <div class="bon-picker-head">
            <div id="bonPickerTitle" class="bon-picker-title">Pilih barang</div>
            <button type="button"
                    class="bon-picker-close"
                    data-bon-picker-close
                    aria-label="Tutup">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
        <div class="bon-picker-search">
            <div class="bon-picker-search-row">
                <i class="bi bi-search bon-picker-search-icon" aria-hidden="true"></i>
                <input id="bonBarangSearch"
                       type="search"
                       class="bon-picker-search-input"
                       placeholder="Cari barang"
                       aria-label="Cari nama barang"
                       autocomplete="off" />
            </div>
            <hr class="page-rule" />
        </div>
        <div class="bon-picker-list">
            @foreach (var barang in Model.Barangs)
            {
                <div class="bon-barang-row">
                    <button type="button"
                            class="bon-picker-item"
                            data-id="@barang.Id"
                            data-nama="@barang.Nama"
                            data-satuan="@barang.Satuan"
                            data-harga="@FormatHarga(barang.Harga)">
                        <span class="bon-picker-item-info">
                            <span class="bon-picker-item-name">@barang.Nama</span>
                            <span class="bon-picker-item-unit">@(string.IsNullOrWhiteSpace(barang.Satuan) ? "-" : barang.Satuan)</span>
                        </span>
                        <span class="bon-picker-item-price">@FormatRupiah(barang.Harga)</span>
                    </button>
                    <hr class="page-rule" />
                </div>
            }
        </div>
        <p class="bon-customer-empty" id="bonBarangEmpty" hidden="@(Model.Barangs.Count == 0 ? null : "hidden")">Belum ada barang di buku. Tambahkan barang dulu.</p>
    </div>
</div>

<div id="bonCustomerPicker" class="bon-picker" hidden>
    <div class="bon-picker-scrim" data-bon-customer-close></div>
    <div class="bon-picker-sheet"
         role="dialog"
         aria-modal="true"
         aria-labelledby="bonCustomerTitle"
         tabindex="-1">
        <div class="bon-picker-head">
            <div id="bonCustomerTitle" class="bon-picker-title">Pilih pelanggan</div>
            <button type="button"
                    class="bon-picker-close"
                    data-bon-customer-close
                    aria-label="Tutup">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
        <div class="bon-picker-search">
            <div class="bon-picker-search-row">
                <i class="bi bi-search bon-picker-search-icon" aria-hidden="true"></i>
                <input id="bonCustomerSearch"
                       type="search"
                       class="bon-picker-search-input"
                       placeholder="Cari nama"
                       aria-label="Cari nama pelanggan"
                       autocomplete="off" />
            </div>
            <hr class="page-rule" />
        </div>
        <div class="bon-picker-list">
            @foreach (var customer in Model.Customers)
            {
                <div class="bon-customer-row">
                    <button type="button"
                            class="bon-picker-item bon-customer-item"
                            data-id="@customer.Id"
                            data-nama="@customer.Nama"
                            data-hp="@customer.NomorHp"
                            data-sisa="@FormatRupiah(customer.SisaHutang)">
                        <span class="bon-picker-item-info">
                            <span class="bon-picker-item-name bon-customer-item-name">@customer.Nama</span>
                            <span class="bon-picker-item-unit bon-customer-item-hp">@(string.IsNullOrWhiteSpace(customer.NomorHp) ? "Tanpa nomor HP" : customer.NomorHp)</span>
                        </span>
                        <span class="bon-picker-item-price bon-customer-item-sisa@(customer.Lunas ? " bon-customer-item-sisa--lunas" : "")">@FormatRupiah(customer.SisaHutang)</span>
                    </button>
                    <hr class="page-rule" />
                </div>
            }
        </div>
        <p class="bon-customer-empty" id="bonCustomerEmpty" hidden="@(Model.Customers.Count == 0 ? null : "hidden")">Belum ada pelanggan yang cocok.</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/custom/features/bon/create.js" asp-append-version="true"></script>
}
