@{
    ViewData["Title"] = "Bon baru";
    ViewData["BackHref"] = Url.Action("Index", "Bon");
}

<hr class="page-rule" />

<form method="get" asp-action="Create" class="pelanggan-form">
    <div class="pelanggan-field">
        <span class="pelanggan-field-label" id="pelangganLabel">Pelanggan</span>
        <div class="bon-field-with-icon">
            <input id="pelanggan" type="hidden" name="pelanggan" value="" />
            <button type="button"
                    id="pilihPelangganBtn"
                    class="bon-picker-trigger bon-customer-trigger is-empty"
                    aria-haspopup="dialog"
                    aria-expanded="false"
                    aria-controls="bonCustomerPicker"
                    aria-labelledby="pelangganLabel pelangganValue">
                <span id="pelangganValue" class="bon-customer-trigger-label">Pilih pelanggan</span>
            </button>
            <i class="bi bi-caret-down bon-field-icon" aria-hidden="true"></i>
        </div>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-field">
        <label class="pelanggan-field-label" for="tanggal">Tanggal</label>
        <div class="bon-field-with-icon">
            <input id="tanggal"
                   type="date"
                   name="tanggal"
                   class="pelanggan-field-input bon-date"
                   value="" />
            <i class="bi bi-calendar bon-field-icon" aria-hidden="true"></i>
        </div>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-field">
        <label class="pelanggan-field-label" for="totalBayar">Total Bayar</label>
        <input id="totalBayar"
               type="text"
               name="totalBayar"
               inputmode="decimal"
               class="pelanggan-field-input bon-money-input"
               placeholder="Tulis total bayar"
               autocomplete="off"
               value="" />
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-field">
        <label class="pelanggan-field-label" for="catatan">Catatan</label>
        <textarea id="catatan"
                  name="catatan"
                  class="pelanggan-field-input pelanggan-field-textarea"
                  placeholder="Tulis catatan"
                  rows="2"></textarea>
        <hr class="page-rule" />
    </div>

    <div class="bon-daftar-head">
        <div class="bon-daftar-title">Daftar barang</div>
        <button type="button" id="tambahBarangBtn" class="bon-tambah" style="pointer-events: auto">
            <i class="bi bi-plus"></i>
            <span>Tambah barang</span>
        </button>
    </div>

    <div id="bonLinesContainer">
        <!-- baris barang akan ditambahkan oleh JavaScript -->
    </div>

    <div class="bon-total-row">
        <div class="bon-total-label">Total belanja</div>
        <div class="bon-total-value" id="totalBelanja">Rp 0</div>
    </div>

    <div class="pelanggan-form-actions">
        <a class="pelanggan-btn pelanggan-btn-batal"
           asp-controller="Bon"
           asp-action="Index">Batal</a>
        <button type="submit" class="pelanggan-btn pelanggan-btn-simpan">Simpan catatan</button>
    </div>
</form>

<template id="bonLineTemplate">
    <div class="bon-line" data-line-index="">
        <div class="bon-field-with-icon">
            <input type="hidden" class="barang-hidden" value="" />
            <button type="button"
                    class="bon-picker-trigger is-empty barang-trigger"
                    aria-haspopup="dialog"
                    aria-expanded="false"
                    aria-controls="bonPicker">
                <span class="barang-trigger-label">Pilih barang</span>
            </button>
            <i class="bi bi-chevron-down bon-field-icon" aria-hidden="true"></i>
        </div>
        <hr class="page-rule" />

        <div class="bon-line-metrics">
            <div class="bon-line-col">
                <div class="pelanggan-field-label">Harga</div>
                <div class="bon-line-money barang-harga">Rp 0</div>
            </div>
            <div class="bon-line-col bon-line-col--qty">
                <label class="pelanggan-field-label">Jumlah</label>
                <input type="number"
                       name="jumlah"
                       min="1"
                       value="1"
                       class="bon-line-qty barang-jumlah" />
            </div>
            <div class="bon-line-col">
                <div class="pelanggan-field-label">Satuan</div>
                <div class="bon-line-satuan barang-satuan">-</div>
            </div>
        </div>

        <div class="bon-line-subtotal">
            <div class="bon-line-col">
                <div class="pelanggan-field-label">Subtotal</div>
                <div class="bon-line-money barang-subtotal">Rp 0</div>
            </div>
            <button type="button" class="bon-hapus hapus-barang" aria-label="Hapus barang" style="pointer-events: auto">
                <i class="bi bi-trash" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</template>

<div id="bonPicker" class="bon-picker" hidden>
    <div class="bon-picker-scrim" data-bon-picker-close></div>
    <div class="bon-picker-sheet"
         role="dialog"
         aria-modal="true"
         aria-labelledby="bonPickerTitle">
        <div class="bon-picker-head">
            <div id="bonPickerTitle" class="bon-picker-title">Pilih barang</div>
            <button type="button"
                    class="bon-picker-close"
                    data-bon-picker-close
                    aria-label="Tutup">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
        <div class="bon-picker-search" aria-hidden="true">
            <div class="bon-picker-search-row">
                <i class="bi bi-search bon-picker-search-icon"></i>
                <span class="bon-picker-search-text">Cari barang</span>
            </div>
            <hr class="page-rule" />
        </div>
        <div class="bon-picker-list">
            <button type="button" class="bon-picker-item" data-nama="Beras Ramos 5 kg" data-satuan="karung" data-harga="Rp 78.000">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Beras Ramos 5 kg</span>
                    <span class="bon-picker-item-unit">karung</span>
                </span>
                <span class="bon-picker-item-price">Rp 78.000</span>
            </button>
            <hr class="page-rule" />
            <button type="button" class="bon-picker-item" data-nama="Minyak Goreng 2 L" data-satuan="botol" data-harga="Rp 34.000">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Minyak Goreng 2 L</span>
                    <span class="bon-picker-item-unit">botol</span>
                </span>
                <span class="bon-picker-item-price">Rp 34.000</span>
            </button>
            <hr class="page-rule" />
            <button type="button" class="bon-picker-item" data-nama="Gula Pasir" data-satuan="kg" data-harga="Rp 17.500">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Gula Pasir</span>
                    <span class="bon-picker-item-unit">kg</span>
                </span>
                <span class="bon-picker-item-price">Rp 17.500</span>
            </button>
            <hr class="page-rule" />
            <button type="button" class="bon-picker-item" data-nama="Telur Ayam" data-satuan="kg" data-harga="Rp 28.000">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Telur Ayam</span>
                    <span class="bon-picker-item-unit">kg</span>
                </span>
                <span class="bon-picker-item-price">Rp 28.000</span>
            </button>
            <hr class="page-rule" />
            <button type="button" class="bon-picker-item" data-nama="Mie Instan" data-satuan="dus" data-harga="Rp 125.000">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Mie Instan</span>
                    <span class="bon-picker-item-unit">dus</span>
                </span>
                <span class="bon-picker-item-price">Rp 125.000</span>
            </button>
            <hr class="page-rule" />
            <button type="button" class="bon-picker-item" data-nama="Kopi Sachet" data-satuan="renceng" data-harga="Rp 12.000">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Kopi Sachet</span>
                    <span class="bon-picker-item-unit">renceng</span>
                </span>
                <span class="bon-picker-item-price">Rp 12.000</span>
            </button>
            <hr class="page-rule" />
            <button type="button" class="bon-picker-item" data-nama="Sabun Mandi" data-satuan="pcs" data-harga="Rp 4.500">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Sabun Mandi</span>
                    <span class="bon-picker-item-unit">pcs</span>
                </span>
                <span class="bon-picker-item-price">Rp 4.500</span>
            </button>
            <hr class="page-rule" />
            <button type="button" class="bon-picker-item" data-nama="Garam Dapur" data-satuan="bungkus" data-harga="Rp 3.000">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Garam Dapur</span>
                    <span class="bon-picker-item-unit">bungkus</span>
                </span>
                <span class="bon-picker-item-price">Rp 3.000</span>
            </button>
            <hr class="page-rule" />
        </div>
    </div>
</div>

@* TODO: load the customers and their sisa hutang from the database when the Bon dinamis slice lands. *@
<div id="bonCustomerPicker" class="bon-picker" hidden>
    <div class="bon-picker-scrim" data-bon-customer-close></div>
    <div class="bon-picker-sheet"
         role="dialog"
         aria-modal="true"
         aria-labelledby="bonCustomerTitle"
         tabindex="-1">
        <div class="bon-picker-head">
            <div id="bonCustomerTitle" class="bon-picker-title">Pilih pelanggan</div>
            <button type="button"
                    class="bon-picker-close"
                    data-bon-customer-close
                    aria-label="Tutup">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
        <div class="bon-picker-search">
            <div class="bon-picker-search-row">
                <i class="bi bi-search bon-picker-search-icon" aria-hidden="true"></i>
                <input id="bonCustomerSearch"
                       type="search"
                       class="bon-picker-search-input"
                       placeholder="Cari nama"
                       aria-label="Cari nama pelanggan"
                       autocomplete="off" />
            </div>
            <hr class="page-rule" />
        </div>
        <div class="bon-picker-list">
            <div class="bon-customer-row">
                <button type="button"
                        class="bon-picker-item bon-customer-item"
                        data-nama="Siti Aminah"
                        data-hp="0812 3456 7890"
                        data-sisa="Rp 185.000">
                    <span class="bon-picker-item-info">
                        <span class="bon-picker-item-name bon-customer-item-name">Siti Aminah</span>
                        <span class="bon-picker-item-unit bon-customer-item-hp">0812 3456 7890</span>
                    </span>
                    <span class="bon-picker-item-price bon-customer-item-sisa">Rp 185.000</span>
                </button>
                <hr class="page-rule" />
            </div>
            <div class="bon-customer-row">
                <button type="button"
                        class="bon-picker-item bon-customer-item"
                        data-nama="Budi Santoso"
                        data-hp="0813 2211 4455"
                        data-sisa="Rp 92.000">
                    <span class="bon-picker-item-info">
                        <span class="bon-picker-item-name bon-customer-item-name">Budi Santoso</span>
                        <span class="bon-picker-item-unit bon-customer-item-hp">0813 2211 4455</span>
                    </span>
                    <span class="bon-picker-item-price bon-customer-item-sisa">Rp 92.000</span>
                </button>
                <hr class="page-rule" />
            </div>
            <div class="bon-customer-row">
                <button type="button"
                        class="bon-picker-item bon-customer-item"
                        data-nama="Rina Wahyuni"
                        data-hp="0857 9900 1122"
                        data-sisa="Rp 48.500">
                    <span class="bon-picker-item-info">
                        <span class="bon-picker-item-name bon-customer-item-name">Rina Wahyuni</span>
                        <span class="bon-picker-item-unit bon-customer-item-hp">0857 9900 1122</span>
                    </span>
                    <span class="bon-picker-item-price bon-customer-item-sisa">Rp 48.500</span>
                </button>
                <hr class="page-rule" />
            </div>
            <div class="bon-customer-row">
                <button type="button"
                        class="bon-picker-item bon-customer-item"
                        data-nama="Agus Salim"
                        data-hp="0819 7788 3344"
                        data-sisa="Rp 0">
                    <span class="bon-picker-item-info">
                        <span class="bon-picker-item-name bon-customer-item-name">Agus Salim</span>
                        <span class="bon-picker-item-unit bon-customer-item-hp">0819 7788 3344</span>
                    </span>
                    <span class="bon-picker-item-price bon-customer-item-sisa bon-customer-item-sisa--lunas">Rp 0</span>
                </button>
                <hr class="page-rule" />
            </div>
        </div>
        <p class="bon-customer-empty" id="bonCustomerEmpty" hidden>Belum ada pelanggan yang cocok.</p>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/bon/create.js" asp-append-version="true"></script>
}
