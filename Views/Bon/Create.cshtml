@{
    ViewData["Title"] = "Bon baru";
    ViewData["BackHref"] = Url.Action("Index", "Bon");
}

<hr class="page-rule" />

<form method="get" asp-action="Create" class="pelanggan-form">
    <div class="pelanggan-field">
        <label class="pelanggan-field-label" for="pelanggan">Pelanggan</label>
        <div class="bon-field-with-icon">
            <select id="pelanggan" name="pelanggan" class="pelanggan-field-input bon-select">
                <option value="" selected>Pilih pelanggan</option>
                <option value="Siti Aminah">Siti Aminah</option>
                <option value="Budi Santoso">Budi Santoso</option>
                <option value="Rina Wahyuni">Rina Wahyuni</option>
                <option value="Agus Salim">Agus Salim</option>
            </select>
            <i class="bi bi-chevron-down bon-field-icon" aria-hidden="true"></i>
        </div>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-field">
        <label class="pelanggan-field-label" for="tanggal">Tanggal</label>
        <div class="bon-field-with-icon">
            <input id="tanggal"
                   type="date"
                   name="tanggal"
                   class="pelanggan-field-input bon-date"
                   value="" />
            <i class="bi bi-calendar bon-field-icon" aria-hidden="true"></i>
        </div>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-field">
        <label class="pelanggan-field-label" for="totalBayar">Total Bayar</label>
        <input id="totalBayar"
               type="text"
               name="totalBayar"
               inputmode="decimal"
               class="pelanggan-field-input bon-money-input"
               placeholder="Tulis total bayar"
               autocomplete="off"
               value="" />
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-field">
        <label class="pelanggan-field-label" for="catatan">Catatan</label>
        <textarea id="catatan"
                  name="catatan"
                  class="pelanggan-field-input pelanggan-field-textarea"
                  placeholder="Tulis catatan"
                  rows="2"></textarea>
        <hr class="page-rule" />
    </div>

    <div class="bon-daftar-head">
        <div class="bon-daftar-title">Daftar barang</div>
        <button type="button" id="tambahBarangBtn" class="bon-tambah" style="pointer-events: auto">
            <i class="bi bi-plus"></i>
            <span>Tambah barang</span>
        </button>
    </div>

    <div id="bonLinesContainer">
        <!-- baris barang akan ditambahkan oleh JavaScript -->
    </div>

    <div class="bon-total-row">
        <div class="bon-total-label">Total belanja</div>
        <div class="bon-total-value" id="totalBelanja">Rp 0</div>
    </div>

    <div class="pelanggan-form-actions">
        <a class="pelanggan-btn pelanggan-btn-batal"
           asp-controller="Bon"
           asp-action="Index">Batal</a>
        <button type="submit" class="pelanggan-btn pelanggan-btn-simpan">Simpan catatan</button>
    </div>
</form>

<template id="bonLineTemplate">
    <div class="bon-line" data-line-index="">
        <div class="bon-field-with-icon">
            <input type="hidden" class="barang-hidden" value="" />
            <button type="button"
                    class="bon-picker-trigger is-empty barang-trigger"
                    aria-haspopup="dialog"
                    aria-expanded="false"
                    aria-controls="bonPicker">
                <span class="barang-trigger-label">Pilih barang</span>
            </button>
            <i class="bi bi-chevron-down bon-field-icon" aria-hidden="true"></i>
        </div>
        <hr class="page-rule" />

        <div class="bon-line-metrics">
            <div class="bon-line-col">
                <div class="pelanggan-field-label">Harga</div>
                <div class="bon-line-money barang-harga">Rp 0</div>
            </div>
            <div class="bon-line-col bon-line-col--qty">
                <label class="pelanggan-field-label">Jumlah</label>
                <input type="number"
                       name="jumlah"
                       min="1"
                       value="1"
                       class="bon-line-qty barang-jumlah" />
            </div>
            <div class="bon-line-col">
                <div class="pelanggan-field-label">Satuan</div>
                <div class="bon-line-satuan barang-satuan">-</div>
            </div>
        </div>

        <div class="bon-line-subtotal">
            <div class="bon-line-col">
                <div class="pelanggan-field-label">Subtotal</div>
                <div class="bon-line-money barang-subtotal">Rp 0</div>
            </div>
            <button type="button" class="bon-hapus hapus-barang" aria-label="Hapus barang" style="pointer-events: auto">
                <i class="bi bi-trash" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</template>

<div id="bonPicker" class="bon-picker" hidden>
    <div class="bon-picker-scrim" data-bon-picker-close></div>
    <div class="bon-picker-sheet"
         role="dialog"
         aria-modal="true"
         aria-labelledby="bonPickerTitle">
        <div class="bon-picker-head">
            <div id="bonPickerTitle" class="bon-picker-title">Pilih barang</div>
            <button type="button"
                    class="bon-picker-close"
                    data-bon-picker-close
                    aria-label="Tutup">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
        <div class="bon-picker-search" aria-hidden="true">
            <div class="bon-picker-search-row">
                <i class="bi bi-search bon-picker-search-icon"></i>
                <span class="bon-picker-search-text">Cari barang</span>
            </div>
            <hr class="page-rule" />
        </div>
        <div class="bon-picker-list">
            <button type="button" class="bon-picker-item" data-nama="Beras Ramos 5 kg" data-satuan="karung" data-harga="Rp 78.000">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Beras Ramos 5 kg</span>
                    <span class="bon-picker-item-unit">karung</span>
                </span>
                <span class="bon-picker-item-price">Rp 78.000</span>
            </button>
            <hr class="page-rule" />
            <button type="button" class="bon-picker-item" data-nama="Minyak Goreng 2 L" data-satuan="botol" data-harga="Rp 34.000">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Minyak Goreng 2 L</span>
                    <span class="bon-picker-item-unit">botol</span>
                </span>
                <span class="bon-picker-item-price">Rp 34.000</span>
            </button>
            <hr class="page-rule" />
            <button type="button" class="bon-picker-item" data-nama="Gula Pasir" data-satuan="kg" data-harga="Rp 17.500">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Gula Pasir</span>
                    <span class="bon-picker-item-unit">kg</span>
                </span>
                <span class="bon-picker-item-price">Rp 17.500</span>
            </button>
            <hr class="page-rule" />
            <button type="button" class="bon-picker-item" data-nama="Telur Ayam" data-satuan="kg" data-harga="Rp 28.000">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Telur Ayam</span>
                    <span class="bon-picker-item-unit">kg</span>
                </span>
                <span class="bon-picker-item-price">Rp 28.000</span>
            </button>
            <hr class="page-rule" />
            <button type="button" class="bon-picker-item" data-nama="Mie Instan" data-satuan="dus" data-harga="Rp 125.000">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Mie Instan</span>
                    <span class="bon-picker-item-unit">dus</span>
                </span>
                <span class="bon-picker-item-price">Rp 125.000</span>
            </button>
            <hr class="page-rule" />
            <button type="button" class="bon-picker-item" data-nama="Kopi Sachet" data-satuan="renceng" data-harga="Rp 12.000">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Kopi Sachet</span>
                    <span class="bon-picker-item-unit">renceng</span>
                </span>
                <span class="bon-picker-item-price">Rp 12.000</span>
            </button>
            <hr class="page-rule" />
            <button type="button" class="bon-picker-item" data-nama="Sabun Mandi" data-satuan="pcs" data-harga="Rp 4.500">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Sabun Mandi</span>
                    <span class="bon-picker-item-unit">pcs</span>
                </span>
                <span class="bon-picker-item-price">Rp 4.500</span>
            </button>
            <hr class="page-rule" />
            <button type="button" class="bon-picker-item" data-nama="Garam Dapur" data-satuan="bungkus" data-harga="Rp 3.000">
                <span class="bon-picker-item-info">
                    <span class="bon-picker-item-name">Garam Dapur</span>
                    <span class="bon-picker-item-unit">bungkus</span>
                </span>
                <span class="bon-picker-item-price">Rp 3.000</span>
            </button>
            <hr class="page-rule" />
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var picker = document.getElementById("bonPicker");
            var shell = document.querySelector(".app-shell");
            var container = document.getElementById("bonLinesContainer");
            var template = document.getElementById("bonLineTemplate");
            var tambahBtn = document.getElementById("tambahBarangBtn");
            var totalEl = document.getElementById("totalBelanja");

            if (!picker || !shell || !container || !template || !tambahBtn) return;

            shell.appendChild(picker);

            var sheet = picker.querySelector(".bon-picker-sheet");
            var lastFocus = null;
            var currentLine = null;
            var lineCounter = 0;

            function focusables() {
                return Array.prototype.slice.call(
                    sheet.querySelectorAll("button:not([disabled])")
                );
            }

            function openPicker(triggerBtn) {
                currentLine = triggerBtn.closest(".bon-line");
                lastFocus = document.activeElement;
                picker.hidden = false;
                picker.classList.add("is-open");
                triggerBtn.setAttribute("aria-expanded", "true");
                var first = focusables()[0];
                if (first) first.focus();
            }

            function closePicker() {
                picker.hidden = true;
                picker.classList.remove("is-open");
                if (lastFocus) {
                    var trigger = lastFocus.closest(".bon-picker-trigger");
                    if (trigger) trigger.setAttribute("aria-expanded", "false");
                    lastFocus.focus();
                }
            }

            function pick(item) {
                if (!currentLine) return;

                var nama = item.getAttribute("data-nama") || "";
                var harga = item.getAttribute("data-harga") || "Rp 0";
                var satuan = item.getAttribute("data-satuan") || "-";

                var hidden = currentLine.querySelector(".barang-hidden");
                var trigger = currentLine.querySelector(".barang-trigger");
                var label = currentLine.querySelector(".barang-trigger-label");
                var hargaEl = currentLine.querySelector(".barang-harga");
                var satuanEl = currentLine.querySelector(".barang-satuan");

                if (hidden) hidden.value = nama;
                if (label) label.textContent = nama;
                if (trigger) trigger.classList.remove("is-empty");
                if (hargaEl) hargaEl.textContent = harga;
                if (satuanEl) satuanEl.textContent = satuan;

                hitungSubtotal(currentLine);
                hitungTotalBelanja();
                hitungSubtotal(currentLine);
                hitungTotalBelanja();
                closePicker();
            }

            function hitungSubtotal(line) {
                var hargaText = (line.querySelector(".barang-harga") || {}).textContent || "Rp 0";
                var jumlah = parseInt((line.querySelector(".barang-jumlah") || {}).value, 10) || 1;
                var angka = parseInt(hargaText.replace(/[^0-9]/g, ""), 10) || 0;
                var subtotal = angka * jumlah;
                var subEl = line.querySelector(".barang-subtotal");
                if (subEl) subEl.textContent = "Rp " + subtotal.toLocaleString("id-ID");
            }

            function hitungTotalBelanja() {
                var lines = container.querySelectorAll(".bon-line");
                var total = 0;
                lines.forEach(function (line) {
                    var subText = (line.querySelector(".barang-subtotal") || {}).textContent || "Rp 0";
                    total += parseInt(subText.replace(/[^0-9]/g, ""), 10) || 0;
                });
                totalEl.textContent = "Rp " + total.toLocaleString("id-ID");
            }

            function buatBaris() {
                var index = lineCounter++;
                var clone = template.content.cloneNode(true);
                var lineDiv = clone.querySelector(".bon-line");
                lineDiv.setAttribute("data-line-index", index);

                var trigger = lineDiv.querySelector(".barang-trigger");
                trigger.addEventListener("click", function () {
                    openPicker(trigger);
                });

                var jumlahInput = lineDiv.querySelector(".barang-jumlah");
                jumlahInput.addEventListener("input", function () {
                    hitungSubtotal(lineDiv);
                    hitungTotalBelanja();
                });

                var hapusBtn = lineDiv.querySelector(".hapus-barang");
                hapusBtn.addEventListener("click", function () {
                    if (container.querySelectorAll(".bon-line").length <= 1) {
                        resetBaris(lineDiv);
                        return;
                    }
                    lineDiv.remove();
                    hitungTotalBelanja();
                });

                container.appendChild(clone);
                return lineDiv;
            }

            function resetBaris(line) {
                var hidden = line.querySelector(".barang-hidden");
                var trigger = line.querySelector(".barang-trigger");
                var label = line.querySelector(".barang-trigger-label");
                var hargaEl = line.querySelector(".barang-harga");
                var satuanEl = line.querySelector(".barang-satuan");
                var jumlah = line.querySelector(".barang-jumlah");
                var subEl = line.querySelector(".barang-subtotal");

                if (hidden) hidden.value = "";
                if (label) label.textContent = "Pilih barang";
                if (trigger) trigger.classList.add("is-empty");
                if (hargaEl) hargaEl.textContent = "Rp 0";
                if (satuanEl) satuanEl.textContent = "-";
                if (jumlah) jumlah.value = "1";
                if (subEl) subEl.textContent = "Rp 0";
                hitungTotalBelanja();
            }

            buatBaris();

            tambahBtn.addEventListener("click", buatBaris);

            picker.addEventListener("click", function (event) {
                if (event.target.closest("[data-bon-picker-close]")) {
                    closePicker();
                    return;
                }
                var item = event.target.closest(".bon-picker-item");
                if (item) pick(item);
            });

            picker.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    event.preventDefault();
                    closePicker();
                    return;
                }
                if (event.key !== "Tab") return;
                var list = focusables();
                if (list.length === 0) return;
                var first = list[0];
                var last = list[list.length - 1];
                if (event.shiftKey && document.activeElement === first) {
                    event.preventDefault();
                    last.focus();
                } else if (!event.shiftKey && document.activeElement === last) {
                    event.preventDefault();
                    first.focus();
                }
            });
        })();
    </script>
}
