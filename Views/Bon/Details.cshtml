@model MyBon.Models.Bon.DTOs.BonDetailDto
@using System.Globalization

@{
    ViewData["Title"] = Model.Nomor;
    ViewData["BackHref"] = Url.Action("Index", "Bon");

    // Same reading as the list, the card and the form, so a page and its card never disagree.
    string FormatRupiah(decimal jumlah) =>
        $"Rp {jumlah.ToString("#,##0.##", CultureInfo.GetCultureInfo("id-ID"))}";

    // The notebook writes the date the Indonesian way: 12 Maret 2026.
    string FormatTanggal(DateOnly tanggal) =>
        tanggal.ToString("d MMMM yyyy", CultureInfo.GetCultureInfo("id-ID"));

    var today = DateOnly.FromDateTime(DateTime.Today);
    var todayIso = today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}

<div class="bon-detail-page">
    <hr class="page-rule" />

    <div class="bon-detail-meta">
        <div class="bon-detail-name">@Model.NamaPelanggan</div>
        <div class="bon-detail-sub">@FormatTanggal(Model.Tanggal) · @Model.Status</div>
    </div>

    <div class="bon-summary">
        <div class="bon-summary-title">Ringkasan</div>
        <div class="bon-summary-row">
            <div class="bon-summary-label">Total belanja</div>
            <div class="bon-summary-value">@FormatRupiah(Model.TotalBelanja)</div>
        </div>
        <div class="bon-summary-row">
            <div class="bon-summary-label">Total bayar</div>
            <div class="bon-summary-value">@FormatRupiah(Model.TotalBayar)</div>
        </div>
        <hr class="page-rule" />
        <div class="bon-summary-row bon-summary-row--sisa">
            <div class="bon-summary-label">Sisa hutang</div>
            <div class="bon-summary-value bon-summary-value--lg">@FormatRupiah(Model.SisaHutang)</div>
        </div>
    </div>

    <div class="bon-detail-actions">
        <button type="button"
                class="bon-action bon-action--bayar"
                id="catatPembayaranBtn"
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="bonPaySheet">
            Catat pembayaran
        </button>
        <button type="button"
                class="bon-action bon-action--barang"
                id="tambahBarangBtn"
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="bonAddSheet">
            <i class="bi bi-plus" aria-hidden="true"></i>
            <span>Tambah barang</span>
        </button>
    </div>

    <div class="bon-detail-section">
        <div class="bon-detail-title">Riwayat pembayaran</div>
        @if (Model.Payments.Count == 0)
        {
            <p class="bon-detail-empty">Belum ada pembayaran.</p>
        }
        else
        {
            @* The rows are read oldest first; the Cicilan label comes from the order, so it is never stored. *@
            <div class="bon-history">
                @for (var index = 0; index < Model.Payments.Count; index++)
                {
                    var payment = Model.Payments[index];
                    <div class="bon-history-row">
                        <div class="bon-history-info">
                            <div class="bon-history-jenis">Cicilan @(index + 1)</div>
                            <div class="bon-history-date">@FormatTanggal(payment.Tanggal)</div>
                        </div>
                        <div class="bon-history-amount">@FormatRupiah(payment.Jumlah)</div>
                    </div>
                    <hr class="page-rule" />
                }
            </div>
        }
    </div>

    <div class="bon-detail-section">
        <div class="bon-detail-title">Daftar barang</div>

        @if (Model.Items.Count == 0)
        {
            <p class="bon-detail-empty">Belum ada barang di bon ini.</p>
        }
        else
        {
            @foreach (var item in Model.Items)
            {
                var rinci = string.IsNullOrWhiteSpace(item.Satuan)
                    ? $"{FormatRupiah(item.HargaSatuan)} × {item.Jumlah}"
                    : $"{FormatRupiah(item.HargaSatuan)} × {item.Jumlah} {item.Satuan}";

                <div class="bon-item">
                    <div class="bon-item-name">@item.NamaBarang</div>
                    <div class="bon-item-rinci">@rinci</div>
                    <div class="bon-item-bottom">
                        <div class="bon-item-date">@FormatTanggal(item.Tanggal)</div>
                        <div class="bon-item-sub">@FormatRupiah(item.Subtotal)</div>
                    </div>
                </div>
                <hr class="page-rule" />
            }
        }

        <div class="bon-item-total">
            <div class="bon-item-total-label">Total belanja</div>
            <div class="bon-item-total-value">@FormatRupiah(Model.TotalBelanja)</div>
        </div>
    </div>
</div>

<div id="bonPaySheet" class="bon-pay" hidden>
    <div class="bon-pay-scrim" data-bon-pay-close></div>
    <div class="bon-pay-sheet"
         role="dialog"
         aria-modal="true"
         aria-labelledby="bonPayTitle"
         tabindex="-1">
        <div class="bon-pay-head">
            <div id="bonPayTitle" class="bon-pay-title">Catat pembayaran</div>
            <button type="button" class="bon-pay-close" data-bon-pay-close aria-label="Tutup">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>

        @if (Model.Lunas)
        {
            <p class="bon-pay-hint">Bon ini sudah lunas.</p>
        }
        else
        {
            <p class="bon-pay-hint">Sisa hutang @FormatRupiah(Model.SisaHutang). Kalau bayar kurang, masuk cicilan.</p>
        }

        <div class="pelanggan-field">
            <label class="pelanggan-field-label" for="bonPayJumlah">Jumlah bayar</label>
            <input id="bonPayJumlah"
                   type="text"
                   inputmode="decimal"
                   class="pelanggan-field-input bon-money-input"
                   placeholder="Tulis jumlah"
                   autocomplete="off" />
            <hr class="page-rule" />
        </div>

        <div class="pelanggan-field">
            <span class="pelanggan-field-label" id="bonPayTanggalLabel">Tanggal</span>
            <div class="bon-field-with-icon">
                <input id="bonPayTanggal" type="hidden" name="tanggal" value="@todayIso" />
                <button type="button"
                        id="bonPayTanggalBtn"
                        class="bon-picker-trigger bon-date-trigger"
                        aria-haspopup="dialog"
                        aria-expanded="false"
                        aria-controls="bonPayCalendar"
                        aria-labelledby="bonPayTanggalLabel bonPayTanggalValue">
                    <span id="bonPayTanggalValue">@FormatTanggal(today)</span>
                </button>
                <i class="bi bi-calendar bon-field-icon bon-date-icon" aria-hidden="true"></i>
            </div>
            <hr class="page-rule" />
        </div>

        <div class="pelanggan-field">
            <label class="pelanggan-field-label" for="bonPayCatatan">Catatan</label>
            <textarea id="bonPayCatatan"
                      class="pelanggan-field-input pelanggan-field-textarea"
                      placeholder="Tulis catatan (opsional)"
                      rows="2"></textarea>
            <hr class="page-rule" />
        </div>

        <button type="button" class="bon-pay-submit" data-bon-pay-save>Simpan pembayaran</button>
    </div>

    <div id="bonPayCalendar" class="bon-cal" hidden>
        <div class="bon-cal-scrim" data-bon-cal-close></div>
        <div class="bon-cal-popup"
             role="dialog"
             aria-modal="true"
             aria-labelledby="bonCalTitle"
             tabindex="-1">
            <div class="bon-cal-head">
                <button type="button" class="bon-cal-nav" data-bon-cal-prev aria-label="Bulan sebelumnya">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                </button>
                <div id="bonCalTitle" class="bon-cal-title" aria-live="polite">Oktober 2026</div>
                <button type="button" class="bon-cal-nav" data-bon-cal-next aria-label="Bulan berikutnya">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
            </div>

            <div class="bon-cal-weekdays" aria-hidden="true">
                <span>Sen</span>
                <span>Sel</span>
                <span>Rab</span>
                <span>Kam</span>
                <span>Jum</span>
                <span>Sab</span>
                <span>Min</span>
            </div>

            <div id="bonCalGrid" class="bon-cal-grid" role="grid" aria-labelledby="bonCalTitle"></div>

            <div class="bon-cal-actions">
                <button type="button" class="bon-cal-clear" data-bon-cal-clear>Clear</button>
                <button type="button" class="bon-cal-today" data-bon-cal-today>Hari ini</button>
            </div>
        </div>
    </div>
</div>

<div id="bonAddSheet" class="bon-add" hidden>
    <div class="bon-add-scrim" data-bon-add-close></div>
    <div class="bon-add-sheet"
         role="dialog"
         aria-modal="true"
         aria-labelledby="bonAddTitle"
         tabindex="-1">
        <div class="bon-add-head">
            <div id="bonAddTitle" class="bon-add-title">Tambah barang</div>
            <button type="button" class="bon-add-close" data-bon-add-close aria-label="Tutup">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>

        <div class="bon-add-search" role="search">
            <div class="bon-add-search-row">
                <i class="bi bi-search bon-add-search-icon" aria-hidden="true"></i>
                <input id="bonAddSearch"
                       type="search"
                       class="bon-add-search-input"
                       placeholder="Cari barang"
                       aria-label="Cari barang"
                       autocomplete="off" />
            </div>
            <hr class="page-rule" />
        </div>

        <div class="bon-add-list">
            <div class="bon-add-row">
                <button type="button" class="bon-add-item" data-nama="Beras Ramos 5 kg" data-satuan="karung" data-harga="Rp 78.000">
                    <span class="bon-add-item-info">
                        <span class="bon-add-item-name">Beras Ramos 5 kg</span>
                        <span class="bon-add-item-unit">karung</span>
                    </span>
                    <span class="bon-add-item-price">Rp 78.000</span>
                </button>
                <hr class="page-rule" />
            </div>
            <div class="bon-add-row">
                <button type="button" class="bon-add-item" data-nama="Minyak Goreng 2 L" data-satuan="botol" data-harga="Rp 34.000">
                    <span class="bon-add-item-info">
                        <span class="bon-add-item-name">Minyak Goreng 2 L</span>
                        <span class="bon-add-item-unit">botol</span>
                    </span>
                    <span class="bon-add-item-price">Rp 34.000</span>
                </button>
                <hr class="page-rule" />
            </div>
            <div class="bon-add-row">
                <button type="button" class="bon-add-item" data-nama="Gula Pasir" data-satuan="kg" data-harga="Rp 17.500">
                    <span class="bon-add-item-info">
                        <span class="bon-add-item-name">Gula Pasir</span>
                        <span class="bon-add-item-unit">kg</span>
                    </span>
                    <span class="bon-add-item-price">Rp 17.500</span>
                </button>
                <hr class="page-rule" />
            </div>
            <div class="bon-add-row">
                <button type="button" class="bon-add-item" data-nama="Telur Ayam" data-satuan="kg" data-harga="Rp 28.000">
                    <span class="bon-add-item-info">
                        <span class="bon-add-item-name">Telur Ayam</span>
                        <span class="bon-add-item-unit">kg</span>
                    </span>
                    <span class="bon-add-item-price">Rp 28.000</span>
                </button>
                <hr class="page-rule" />
            </div>
            <div class="bon-add-row">
                <button type="button" class="bon-add-item" data-nama="Mie Instan" data-satuan="dus" data-harga="Rp 125.000">
                    <span class="bon-add-item-info">
                        <span class="bon-add-item-name">Mie Instan</span>
                        <span class="bon-add-item-unit">dus</span>
                    </span>
                    <span class="bon-add-item-price">Rp 125.000</span>
                </button>
                <hr class="page-rule" />
            </div>
            <div class="bon-add-row">
                <button type="button" class="bon-add-item" data-nama="Kopi Sachet" data-satuan="renceng" data-harga="Rp 12.000">
                    <span class="bon-add-item-info">
                        <span class="bon-add-item-name">Kopi Sachet</span>
                        <span class="bon-add-item-unit">renceng</span>
                    </span>
                    <span class="bon-add-item-price">Rp 12.000</span>
                </button>
                <hr class="page-rule" />
            </div>
            <div class="bon-add-row">
                <button type="button" class="bon-add-item" data-nama="Sabun Mandi" data-satuan="pcs" data-harga="Rp 4.500">
                    <span class="bon-add-item-info">
                        <span class="bon-add-item-name">Sabun Mandi</span>
                        <span class="bon-add-item-unit">pcs</span>
                    </span>
                    <span class="bon-add-item-price">Rp 4.500</span>
                </button>
                <hr class="page-rule" />
            </div>
            <div class="bon-add-row">
                <button type="button" class="bon-add-item" data-nama="Garam Dapur" data-satuan="bungkus" data-harga="Rp 3.000">
                    <span class="bon-add-item-info">
                        <span class="bon-add-item-name">Garam Dapur</span>
                        <span class="bon-add-item-unit">bungkus</span>
                    </span>
                    <span class="bon-add-item-price">Rp 3.000</span>
                </button>
                <hr class="page-rule" />
            </div>
        </div>

        <p class="bon-add-empty" id="bonAddEmpty" hidden>Belum ada barang yang cocok.</p>
    </div>
</div>

@section Scripts {
    <script src="~/custom/features/bon/details.js" asp-append-version="true"></script>
}


