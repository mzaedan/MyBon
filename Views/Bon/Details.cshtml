        <div class="bon-item">
            <div class="bon-item-name">Telur Ayam</div>
            <div class="bon-item-rinci">Rp 28.000 × 1 kg</div>
            <div class="bon-item-bottom">
                <div class="bon-item-date">15 Maret 2026</div>
                <div class="bon-item-sub">Rp 28.000</div>
            </div>
        </div>
        <hr class="page-rule" />

        <div class="bon-item-total">
            <div class="bon-item-total-label">Total belanja</div>
            <div class="bon-item-total-value">Rp 140.000</div>
        </div>
    </div>
