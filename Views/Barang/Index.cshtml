@using System.Globalization
@model IReadOnlyList<MyBon.Domain.Entities.Barang>

@{
    ViewData["Title"] = "Barang";

    // Prices read like the export mockup: Rp 78.000, without decimals.
    string FormatRupiah(decimal harga) =>
        $"Rp {harga.ToString("N0", CultureInfo.GetCultureInfo("id-ID"))}";
}

@if (Model.Count == 0)
{
    @* Empty state: same shape as the Pelanggan list, so an empty notebook reads the same on both screens. *@
    <div class="barang-empty">
        <hr class="page-rule" />

        <div class="barang-empty-body">
            <div class="barang-empty-art">
                <div class="barang-empty-lottie" id="lottie-barang-empty"></div>
            </div>

            <p class="barang-empty-copy">
                Belum ada barang di buku. Tulis barang baru untuk mulai mencatat.
            </p>

            <a class="cta-catat-bon" asp-controller="Barang" asp-action="Create">Tulis barang baru</a>
        </div>
    </div>
}
else
{
    <div class="barang-page">
        <hr class="page-rule" />

        <div class="barang-search" aria-hidden="true">
            <div class="barang-search-row">
                <i class="bi bi-search barang-search-icon"></i>
                <span class="barang-search-text">Cari barang</span>
            </div>
            <hr class="page-rule" />
        </div>

        <div class="barang-list-title">@Model.Count barang di buku</div>

        <div class="barang-cards">
            @foreach (var barang in Model)
            {
                <div class="barang-card">
                    <div class="barang-card-info">
                        <div class="barang-card-name">@barang.Nama</div>
                        @if (!string.IsNullOrWhiteSpace(barang.Satuan))
                        {
                            <div class="barang-card-unit">@barang.Satuan</div>
                        }
                    </div>
                    <div class="barang-card-price">@FormatRupiah(barang.Harga)</div>
                </div>
            }
        </div>

        <a class="cta-catat-bon" asp-controller="Barang" asp-action="Create">Tulis barang baru</a>
    </div>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js"></script>
    <script src="~/custom/features/barang/index.js" asp-append-version="true"></script>
}

