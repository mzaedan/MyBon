@model MyBon.Models.Common.PagedResult<MyBon.Domain.Entities.Barang>

@{
    ViewData["Title"] = "Barang";
    var status = TempData["BarangStatus"] as string;
    var query = (ViewData["SearchQuery"] as string ?? string.Empty).Trim();
    var isSearching = query.Length > 0;
}

@if (Model.Total == 0 && !isSearching)
{
    @* Empty state: same shape as the Pelanggan list, so an empty notebook reads the same on both screens. *@
    <div class="barang-empty">
        <hr class="page-rule" />

        <div class="barang-empty-body">
            <div class="barang-empty-art">
                <div class="barang-empty-lottie" id="lottie-barang-empty"></div>
            </div>

            <p class="barang-empty-copy">
                Belum ada barang di buku. Tulis barang baru untuk mulai mencatat.
            </p>

            <a class="cta-catat-bon" asp-controller="Barang" asp-action="Create">Tulis barang baru</a>
        </div>
    </div>
}
else
{
    // The total, not the page: the list reports every match while it paints eight at a time.
    var countTitle = isSearching
        ? $"{Model.Total} barang cocok"
        : $"{Model.Total} barang di buku";

    <div class="barang-page">
        <hr class="page-rule" />

        @if (!string.IsNullOrWhiteSpace(status))
        {
            <p class="barang-notice" role="status">@status</p>
        }

        @* A real field. Only the item name is matched, so a satuan typed in the box finds nothing. *@
        <form class="barang-search" method="get" asp-controller="Barang" asp-action="Index" role="search">
            <div class="barang-search-row">
                <i class="bi bi-search barang-search-icon" aria-hidden="true"></i>
                <input class="barang-search-input" id="barang-search-input" type="search" name="q"
                       value="@query" placeholder="Cari barang" autocomplete="off"
                       aria-label="Cari nama barang" />
            </div>
            <hr class="page-rule" />
        </form>

        <div class="barang-list-title@(Model.Total == 0 ? " barang-hidden" : "")" id="barang-list-title">@countTitle</div>

        <div class="barang-card-stack" id="barang-card-stack" data-search-url="@(Url.Action("Search", "Barang"))">
            <partial name="_Cards" model="Model" />
        </div>

        <a class="cta-catat-bon" asp-controller="Barang" asp-action="Create">Tulis barang baru</a>
    </div>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js"></script>
    <script src="~/custom/features/barang/index.js" asp-append-version="true"></script>
}

