@using System.Globalization
@model MyBon.Models.Common.PagedResult<MyBon.Domain.Entities.Barang>

@{
    // Prices read like the export mockup: Rp 78.000, without decimals.
    string FormatRupiah(decimal harga) =>
        $"Rp {harga.ToString("N0", CultureInfo.GetCultureInfo("id-ID"))}";
}

@* The search and load-more scripts read the total back, so the list title keeps reporting every match
   while this page paints only the rows it was handed. *@
<div class="barang-cards" id="barang-cards" data-total="@Model.Total">
    @foreach (var barang in Model.Items)
    {
        @* The card opens the detail sheet, and the sheet carries the Ubah barang action. *@
        <a class="barang-card" asp-controller="Barang" asp-action="Details" asp-route-id="@barang.Id">
            <div class="barang-card-info">
                <div class="barang-card-name">@barang.Nama</div>
                @if (!string.IsNullOrWhiteSpace(barang.Satuan))
                {
                    <div class="barang-card-unit">@barang.Satuan</div>
                }
            </div>
            <div class="barang-card-price">@FormatRupiah(barang.Harga)</div>
        </a>
    }
</div>

@if (Model.Total == 0)
{
    <p class="barang-search-empty">Belum ada barang yang cocok. Coba kata kunci lain.</p>
}

@if (Model.HasMore)
{
    @* A plain button: the next page comes from the server, and the server marks the last page by
       not rendering this button at all. *@
    <button type="button" class="barang-load-more" id="barang-load-more" data-next-page="@(Model.Page + 1)">Muat barang berikutnya</button>
}
