@model CreatePelangganRequest

@{
    ViewData["Title"] = "Nama baru";
    ViewData["BackHref"] = Url.Action("Index", "Pelanggan");
}

<hr class="page-rule" />

<form method="post" asp-action="Create" class="pelanggan-form">
    <div asp-validation-summary="ModelOnly" class="pelanggan-field-error" role="alert"></div>

    <div class="pelanggan-field">
        <label class="pelanggan-field-label" asp-for="Nama">Nama</label>
        <input asp-for="Nama"
               type="text"
               class="pelanggan-field-input"
               placeholder="Tulis nama"
               autocomplete="name" />
        <span asp-validation-for="Nama" class="pelanggan-field-error"></span>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-field">
        <label class="pelanggan-field-label" asp-for="NomorHp">Nomor HP</label>
        <input asp-for="NomorHp"
               type="tel"
               class="pelanggan-field-input"
               placeholder="Tulis nomor HP"
               autocomplete="tel" />
        <span asp-validation-for="NomorHp" class="pelanggan-field-error"></span>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-field">
        <label class="pelanggan-field-label" asp-for="Alamat">Alamat</label>
        <textarea asp-for="Alamat"
                  class="pelanggan-field-input pelanggan-field-textarea"
                  placeholder="Tulis alamat"
                  rows="2"
                  autocomplete="street-address"></textarea>
        <span asp-validation-for="Alamat" class="pelanggan-field-error"></span>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-form-actions">
        <a class="pelanggan-btn pelanggan-btn-batal"
           asp-controller="Pelanggan"
           asp-action="Index">Batal</a>
        <button type="submit" class="pelanggan-btn pelanggan-btn-simpan">Simpan pelanggan</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
