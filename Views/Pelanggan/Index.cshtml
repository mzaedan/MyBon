@model IReadOnlyList<MyBon.Domain.Entities.Pelanggan>

@{
    ViewData["Title"] = "Pelanggan";
    var status = TempData["PelangganStatus"] as string;
    var query = (ViewData["SearchQuery"] as string ?? string.Empty).Trim();
    var isSearching = query.Length > 0;
}

@if (Model.Count == 0 && !isSearching)
{
    @* Empty state *@
    <div class="pelanggan-empty">
        <hr class="page-rule" />

        <div class="pelanggan-empty-body">
            <div class="pelanggan-empty-art">
                <div class="pelanggan-empty-lottie" id="lottie-notebook"></div>
            </div>

            <p class="pelanggan-empty-copy">
                Belum ada nama di buku. Tulis nama, nomor HP, dan alamat pelanggan.
            </p>

            <a class="pelanggan-empty-btn" asp-controller="Pelanggan" asp-action="Create">
                Tulis nama baru
            </a>
        </div>
    </div>
}
else
{
    var countTitle = isSearching
        ? $"{Model.Count} nama cocok"
        : $"{Model.Count} nama di buku";

    @* Populated state *@
    <div class="pelanggan-page">
        <hr class="page-rule" />

        @if (!string.IsNullOrWhiteSpace(status))
        {
            <p class="pelanggan-notice" role="status">@status</p>
        }

        <form class="pelanggan-search" method="get" asp-controller="Pelanggan" asp-action="Index" role="search">
            <div class="pelanggan-search-row">
                <i class="bi bi-search pelanggan-search-icon" aria-hidden="true"></i>
                <input class="pelanggan-search-input" id="pelanggan-search-input" type="search" name="q"
                       value="@query" placeholder="Cari nama" autocomplete="off"
                       aria-label="Cari nama pelanggan" />
            </div>
            <hr class="page-rule" />
        </form>

        <div class="pelanggan-list-title@(Model.Count == 0 ? " pelanggan-hidden" : "")" id="pelanggan-list-title">@countTitle</div>

        <div class="pelanggan-card-stack" id="pelanggan-card-stack" data-search-url="@(Url.Action("Search", "Pelanggan"))">
            <partial name="_Cards" model="Model" />
        </div>

        <a class="cta-catat-bon" asp-controller="Pelanggan" asp-action="Create">Tulis nama baru</a>
    </div>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js"></script>
    <script src="~/custom/features/pelanggan/index.js" asp-append-version="true"></script>
}
