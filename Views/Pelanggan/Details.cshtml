@model MyBon.Models.Pelanggan

@{
    ViewData["Title"] = Model.Nama;
    ViewData["BackHref"] = Url.Action("Index", "Pelanggan");
}

<hr class="page-rule" />

<div class="pelanggan-form">
    <div class="pelanggan-field">
        <div class="pelanggan-field-label">Nama</div>
        <p class="pelanggan-field-value">@Model.Nama</p>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-field">
        <div class="pelanggan-field-label">Nomor HP</div>
        <p class="pelanggan-field-value">@(Model.NomorHp ?? "—")</p>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-field">
        <div class="pelanggan-field-label">Alamat</div>
        <p class="pelanggan-field-value">@(Model.Alamat ?? "—")</p>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-form-actions">
        <a class="pelanggan-btn pelanggan-btn-batal"
           asp-controller="Pelanggan"
           asp-action="Index">Ubah data</a>
        <a class="pelanggan-btn pelanggan-btn-simpan"
           asp-controller="Pelanggan"
           asp-action="Index">Hapus dari buku</a>
    </div>
</div>
