@model IReadOnlyList<MyBon.Domain.Entities.Pelanggan>

@{
    // The live search script reads this back, so the reveal size stays in one place.
    const int pageSize = 8;
    var index = 0;
}

<div class="pelanggan-cards" id="pelanggan-cards" data-page-size="@pageSize">
    @foreach (var pelanggan in Model)
    {
        <a class="pelanggan-card@(index >= pageSize ? " pelanggan-card--hidden" : "")" asp-controller="Pelanggan" asp-action="Details" asp-route-id="@pelanggan.Id">
            <div class="pelanggan-card-name">@pelanggan.Nama</div>
            @if (!string.IsNullOrEmpty(pelanggan.NomorHp))
            {
                <div class="pelanggan-card-meta">@pelanggan.NomorHp</div>
            }
            @if (!string.IsNullOrEmpty(pelanggan.Alamat))
            {
                <div class="pelanggan-card-meta">@pelanggan.Alamat</div>
            }
        </a>
        index++;
    }
</div>

@if (Model.Count == 0)
{
    <p class="pelanggan-search-empty">Belum ada nama yang cocok. Coba kata kunci lain.</p>
}

@if (Model.Count > pageSize)
{
    <button type="button" class="pelanggan-load-more" id="pelanggan-load-more">Muat nama berikutnya</button>
}
