@{
    ViewData["Title"] = "Ringkasan bon";
}

<div class="dashboard-page">
    <hr class="page-rule" />

    <section class="hutang-block">
        <div class="hutang-label">Total hutang semua customer</div>
        <div class="hutang-value">Rp 325.500</div>
        <div class="hutang-hint">Semua bon yang belum lunas</div>
    </section>

    <hr class="page-rule" />

    <div class="sold-row">
        <div class="sold-label">Jumlah produk terjual</div>
        <div class="sold-value">47</div>
    </div>

    <div class="list-title">Belum lunas</div>

    <div class="debt-list">
        <div class="debt-row">
            <div class="debt-content">
                <span class="debt-name">Siti Aminah</span>
                <span class="debt-amount">Rp 185.000</span>
            </div>
            <hr class="page-rule" />
        </div>
        <div class="debt-row">
            <div class="debt-content">
                <span class="debt-name">Budi Santoso</span>
                <span class="debt-amount">Rp 92.000</span>
            </div>
            <hr class="page-rule" />
        </div>
        <div class="debt-row">
            <div class="debt-content">
                <span class="debt-name">Rina Wahyuni</span>
                <span class="debt-amount">Rp 48.500</span>
            </div>
            <hr class="page-rule" />
        </div>
    </div>

    <button type="button" class="cta-catat-bon">Catat bon baru</button>
</div>
