<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>@ViewData["Title"] - MyBon</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyBon.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <div class="app-shell">
        <header class="app-header">
            <div class="app-header-inner">
                <h1 class="app-title">MyBon</h1>
                <button type="button" class="icon-btn" aria-label="Notifikasi">
                    <i class="bi bi-bell"></i>
                </button>
            </div>
        </header>

        <main class="app-main" role="main">
            @RenderBody()
        </main>

        <nav class="bottom-nav" aria-label="Navigasi utama">
            @{
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
                bool IsActive(string controller, string action) =>
                    string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
                    && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
            }
            <a class="bottom-nav-item @(IsActive("Home", "Index") ? "active" : "")"
               asp-controller="Home" asp-action="Index">
                <i class="bi bi-house@(IsActive("Home", "Index") ? "-fill" : "")"></i>
                <span>Beranda</span>
            </a>
            <a class="bottom-nav-item" href="#explore">
                <i class="bi bi-search"></i>
                <span>Cari</span>
            </a>
            <a class="bottom-nav-item" href="#history">
                <i class="bi bi-clock-history"></i>
                <span>Riwayat</span>
            </a>
            <a class="bottom-nav-item @(IsActive("Home", "Privacy") ? "active" : "")"
               asp-controller="Home" asp-action="Privacy">
                <i class="bi bi-person@(IsActive("Home", "Privacy") ? "-fill" : "")"></i>
                <span>Akun</span>
            </a>
        </nav>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
