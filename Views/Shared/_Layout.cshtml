<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>@ViewData["Title"] - MyBon</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700&family=Fraunces:opsz,wght@9..144,600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyBon.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
        bool IsActive(string controller) =>
            string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        var backHref = ViewData["BackHref"] as string;
        var showBack = !string.IsNullOrWhiteSpace(backHref);
    }
    <div class="app-shell">
        <header class="app-header">
            <div class="app-header-inner">
                @if (showBack)
                {
                    <a class="app-header-back" href="@backHref" aria-label="Kembali">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </a>
                }
                <div class="app-header-text">
                    <p class="app-wordmark">MY BON</p>
                    <h1 class="app-screen-title">@ViewData["Title"]</h1>
                </div>
            </div>
        </header>

        <main class="app-main" role="main">
            @RenderBody()
        </main>

        <nav class="bottom-nav" aria-label="Navigasi utama">
            <div class="bottom-nav-bar">
                <a class="bottom-nav-item @(IsActive("Dashboard") ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Index">
                    <i class="bi @(IsActive("Dashboard") ? "bi-house-fill" : "bi-house")"></i>
                    <span>Dashboard</span>
                </a>
                <a class="bottom-nav-item @(IsActive("Pelanggan") ? "active" : "")"
                   asp-controller="Pelanggan" asp-action="Index">
                    <i class="bi @(IsActive("Pelanggan") ? "bi-people-fill" : "bi-people")"></i>
                    <span>Pelanggan</span>
                </a>
                <a class="bottom-nav-item @(IsActive("Barang") ? "active" : "")"
                   asp-controller="Barang" asp-action="Index">
                    <i class="bi @(IsActive("Barang") ? "bi-box-seam-fill" : "bi-box-seam")"></i>
                    <span>Barang</span>
                </a>
                <a class="bottom-nav-item @(IsActive("Bon") ? "active" : "")"
                   asp-controller="Bon" asp-action="Index">
                    <i class="bi bi-journal-text"></i>
                    <span>Catat Bon</span>
                </a>
            </div>
        </nav>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
