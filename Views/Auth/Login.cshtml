@model LoginRequest

@{
    ViewData["Title"] = "Masuk";
    Layout = "_LayoutAuth";

    // A failed sign-in arrives as a model-level message, so it paints above the fields.
    var messages = ViewData.ModelState[string.Empty]?.Errors
        .Select(error => error.ErrorMessage)
        .Where(text => !string.IsNullOrWhiteSpace(text))
        .ToList() ?? new List<string>();
}

@* The header reuses the shell's own wordmark/title classes so the login cannot drift from
   the header every other page renders. *@
<form class="auth-page" method="post" asp-controller="Auth" asp-action="Login">
    <input type="hidden" asp-for="ReturnUrl" />
    <header class="auth-head">
        <p class="app-wordmark">MY BON</p>
        <h1 class="app-screen-title">Masuk</h1>
    </header>

    <hr class="page-rule" />

    <section class="auth-brand">
        <div class="auth-mark" aria-hidden="true">
            <div class="auth-nota">
                <span class="auth-nota-rp">Rp</span>
                <i class="bi bi-check-lg auth-nota-check"></i>
                <span class="auth-nota-fold"></span>
            </div>
        </div>

        <div class="auth-brand-text">
            <p class="auth-tagline">Buku hutang warung Bi Ai</p>
            <p class="auth-desc">Simpan bon, pantau hutang pelanggan, dan catat bayaran di satu buku.</p>
        </div>
    </section>

    @if (messages.Count > 0)
    {
        <p class="auth-error" role="alert">@messages[0]</p>
    }

    <div class="auth-form">
        <div class="pelanggan-field auth-field">
            <label class="pelanggan-field-label" asp-for="Username">Username</label>
            <input class="pelanggan-field-input"
                   asp-for="Username"
                   type="text"
                   placeholder="Tulis username"
                   autocapitalize="none"
                   autocorrect="off"
                   spellcheck="false"
                   autocomplete="username" />
            <span asp-validation-for="Username" class="pelanggan-field-error"></span>
            <hr class="page-rule" />
        </div>

        <div class="pelanggan-field auth-field">
            <label class="pelanggan-field-label" asp-for="Password">Kata sandi</label>
            <div class="auth-password">
                <input class="pelanggan-field-input"
                       asp-for="Password"
                       type="password"
                       placeholder="Tulis kata sandi"
                       autocomplete="current-password" />
                <button type="button"
                        class="auth-password-toggle"
                        data-password-toggle
                        aria-controls="Password"
                        aria-pressed="false"
                        aria-label="Tampilkan kata sandi"
                        title="Tampilkan kata sandi">
                    <i class="bi bi-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="pelanggan-field-error"></span>
            <hr class="page-rule" />
        </div>
    </div>

    <label class="auth-remember">
        <input type="checkbox" asp-for="IngatSaya" />
        <span>Ingat saya</span>
    </label>

    <div class="auth-forgot-row">
        <button type="button" class="auth-forgot">Lupa kata sandi?</button>
    </div>

    <div class="auth-actions">
        <button type="submit" class="auth-btn auth-btn-primary">Masuk ke buku hutang</button>
    </div>

    <div class="auth-spacer"></div>

    <hr class="page-rule" />
</form>

@section Scripts {
    <script src="~/custom/features/auth/login.js" asp-append-version="true"></script>
}
