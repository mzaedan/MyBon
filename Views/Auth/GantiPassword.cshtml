@model GantiPasswordRequest

@{
    ViewData["Title"] = "Ganti kata sandi";
    var status = TempData["AuthStatus"] as string;
}

<hr class="page-rule" />

@if (!string.IsNullOrWhiteSpace(status))
{
    <p class="pelanggan-notice" role="status">@status</p>
}

<form method="post" asp-controller="Auth" asp-action="GantiPassword" class="pelanggan-form">
    <div asp-validation-summary="ModelOnly" class="pelanggan-field-error" role="alert"></div>

    <div class="pelanggan-field">
        <label class="pelanggan-field-label" asp-for="PasswordLama">Kata sandi lama</label>
        <input asp-for="PasswordLama"
               type="password"
               class="pelanggan-field-input"
               placeholder="Tulis kata sandi lama"
               autocomplete="current-password" />
        <span asp-validation-for="PasswordLama" class="pelanggan-field-error"></span>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-field">
        <label class="pelanggan-field-label" asp-for="PasswordBaru">Kata sandi baru</label>
        <input asp-for="PasswordBaru"
               type="password"
               class="pelanggan-field-input"
               placeholder="Minimal 8 karakter"
               autocomplete="new-password" />
        <span asp-validation-for="PasswordBaru" class="pelanggan-field-error"></span>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-field">
        <label class="pelanggan-field-label" asp-for="KonfirmasiPassword">Ulangi kata sandi baru</label>
        <input asp-for="KonfirmasiPassword"
               type="password"
               class="pelanggan-field-input"
               placeholder="Tulis ulang kata sandi baru"
               autocomplete="new-password" />
        <span asp-validation-for="KonfirmasiPassword" class="pelanggan-field-error"></span>
        <hr class="page-rule" />
    </div>

    <div class="pelanggan-form-actions">
        <button type="submit" class="pelanggan-btn pelanggan-btn-simpan">Simpan kata sandi</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}